# Integración con Systeme.io (lib/systeme.ts + app/api/lead/route.ts).
# Todos los leads del sitio (Academy, Community, Lab, Kit) pasan por la ruta
# interna /api/lead, que reenvía a Systeme.io con esta API key. Se genera en
# tu cuenta de Systeme.io: Perfil → "Public API keys".
# Si se deja vacía, /api/lead responde en modo demo: valida y muestra éxito,
# pero no guarda el lead en ningún lado.
SYSTEME_API_KEY=

# ID numérico del tag en Systeme.io que se asigna a cada contacto según de
# dónde vino el lead (Contacts → Tags, crea uno por línea y copia su ID).
# Sin el tag correspondiente, el contacto igual se crea en Systeme, solo
# queda sin clasificar.
SYSTEME_TAG_ID_ACADEMY=
SYSTEME_TAG_ID_COMMUNITY=
SYSTEME_TAG_ID_LAB=
SYSTEME_TAG_ID_KIT=

# Tag ya creado en Systeme.io para Growth Partner, pero todavía sin
# formulario/fuente de lead en el código que lo use. Guardado aquí para
# cuando se construya esa sección (ver TODO en lib/systeme.ts).
SYSTEME_TAG_ID_GROWTH=
